# ============================================================
# Torres App — Variáveis de ambiente
# Copie este arquivo para .env.local e preencha com seus valores.
# NUNCA commite .env.local com valores reais.
# ============================================================

# ----- Supabase (público — seguro no frontend) -----
VITE_API_URL=https://seu-projeto.supabase.co
VITE_API_ANON_KEY=sua-anon-key-publica

# ----- App -----
VITE_APP_NAME=Torres Vistoria
# Dev: http://localhost:3000
# Produção Torres Consulta: https://www.torresconsultas.com.br
# Produção Torres Vistoria: https://vistoria.torresconsultas.com.br
VITE_APP_URL=http://localhost:3000
# Atalhos de login demo (sempre false em produção)
VITE_DEMO_MODE=false

# ----- Playwright E2E — NÃO versionar senhas reais -----
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_INSPECTOR_EMAIL=
# E2E_INSPECTOR_PASSWORD=
# E2E_ADMIN_NAME=
# E2E_INSPECTOR_NAME=

# ----- Supabase CLI / Migrations (somente local ou CI) -----
# DB_PROJECT_ID=seu-project-id
# DB_ACCESS_TOKEN=seu-token-de-acesso

# ----- Edge Functions (secrets do servidor — NUNCA no frontend) -----
# SUPABASE_SERVICE_ROLE_KEY=   (configurar via supabase secrets set)
# SITE_URL=https://www.torresconsultas.com.br
# ALLOWED_ORIGINS=https://www.torresconsultas.com.br,https://torresconsultas.com.br,https://vistoria.torresconsultas.com.br

# ----- Resend (e-mail — futuro, configurar como secret nas Edge Functions) -----
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@torresconsultas.com.br
# Para o Send Email Hook (Supabase Auth → Edge Function)
# SEND_EMAIL_HOOK_SECRET=v1,whsec_<base64_secret>
# (Opcional) nome exibido no from:
# RESEND_FROM_NAME=Torres

# ----- Gateway de pagamento (futuro — configurar como secret) -----
# PAYMENT_PROVIDER=           (stripe | mercadopago | pagarme | asaas)
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=

# ----- Consulta veicular (futuro — configurar como secret) -----
# VEHICLE_LOOKUP_API_KEY=
# VEHICLE_LOOKUP_API_URL=
