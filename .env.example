# Backend (URL e chave pública — nunca commitar valores reais)
VITE_API_URL=https://seu-backend.exemplo.com
VITE_API_ANON_KEY=sua-chave-publica

# App
VITE_APP_NAME=Torres Vistoria
# Dev: localhost. Produção (Torres Consulta): https://www.torresconsultas.com.br
VITE_APP_URL=http://localhost:3000
# Atalhos de login demo (sempre false em produção)
VITE_DEMO_MODE=false

# Playwright E2E autenticado — NÃO versionar senhas reais
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_INSPECTOR_EMAIL=
# E2E_INSPECTOR_PASSWORD=
# E2E_ADMIN_NAME=
# E2E_INSPECTOR_NAME=

# CLI / migrations (somente local ou CI — não usar no frontend)
# DB_PROJECT_ID=seu-project-id
# DB_ACCESS_TOKEN=seu-token-de-acesso

# Edge Functions (secrets do servidor — não expor no frontend)
# CORS já libera localhost, *.vercel.app e torresconsultas.com.br (com e sem www).
# SITE_URL=https://www.torresconsultas.com.br
# ALLOWED_ORIGINS=https://www.torresconsultas.com.br,https://torresconsultas.com.br
